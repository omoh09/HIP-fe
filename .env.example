# Frontend runtime configuration. Never commit .env or real secrets.

# Laravel API base URL, e.g. https://api.example.com
API_BASE_URL=

# Optional legacy server-to-server token. The new public payment-link flow does not require
# a provider secret or Paystack public key in the browser.
INTERNAL_API_TOKEN=

# Optional public site URL used by deployment tooling.
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=

# Google OAuth client ID (public; configure the matching origin in Google Cloud Console).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Laravel public endpoint that verifies the Google Identity Services credential and returns { token, user }.
GOOGLE_AUTH_ENDPOINT=/api/v1/auth/social/google

# Passwordless email OTP. The matching Laravel endpoints are included in hip-be v1.1+.
NEXT_PUBLIC_OTP_LOGIN_ENABLED=true
# Override these if your Laravel routes use different paths.
OTP_REQUEST_ENDPOINT=/api/v1/auth/otp/request
OTP_VERIFY_ENDPOINT=/api/v1/auth/otp/verify

# Legacy database/billing variables from the original starter. Remove them when the
# corresponding starter modules are removed from the project.
POSTGRES_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AUTH_SECRET=

# Existing account-registration verification routes (if your backend requires email verification).
ACCOUNT_VERIFY_ENDPOINT=/api/v1/auth/verify-otp
ACCOUNT_RESEND_ENDPOINT=/api/v1/auth/resend-otp

# Marketing / support links. Use a full international WhatsApp number without spaces, e.g. 2348012345678.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Canonical public URL used by metadata, PWA and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social profile examples (replace with real official Hip Homorrd profiles; leave blank to hide).
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/hiphomorrd
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/hiphomorrd
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/hiphomorrd
# NEXT_PUBLIC_SOCIAL_X=https://x.com/hiphomorrd
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@hiphomorrd
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@hiphomorrd
